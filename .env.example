# =============================================================================
# 501e — variables d'environnement
# Copier ce fichier en `.env` puis adapter les valeurs.
# Les valeurs de la table `settings` (écran Admin > Paramètres) priment sur
# les valeurs DISCORD_* marquées (*) ci-dessous, qui servent de valeurs par défaut.
# =============================================================================

NODE_ENV=development

# --- URLs -------------------------------------------------------------------
# URL publique du site telle que vue par le navigateur (sert aux redirections OAuth,
# aux cookies Secure, au sitemap et aux balises Open Graph).
# En dev avec `ng serve` : http://localhost:4200 ; avec Docker Compose : http://localhost:4000
PUBLIC_URL=http://localhost:4200
# Port d'écoute de l'API
API_PORT=3000
# URL de l'API vue depuis le serveur SSR Angular (proxy /api + rendu serveur)
API_INTERNAL_URL=http://localhost:3000

# --- Base de données (PostgreSQL + PostGIS) ----------------------------------
POSTGRES_USER=501e
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=501e
DATABASE_URL=postgresql://501e:change-me-db-password@localhost:5432/501e

# --- Secrets ------------------------------------------------------------------
# Chaînes aléatoires longues (ex. `openssl rand -hex 32`). Ne jamais les committer.
SESSION_SECRET=change-me-session-secret-at-least-32-chars
# Sel utilisé pour pseudonymiser les IP et les identifiants dans les logs
HASH_SALT=change-me-hash-salt-at-least-32-chars
# Jeton partagé entre le bot et l'API (routes /internal)
INTERNAL_API_TOKEN=change-me-internal-token-at-least-32-chars
# Durée de session glissante (jours)
SESSION_TTL_DAYS=7

# --- Discord ------------------------------------------------------------------
# mock : connexion simulée (choix d'un membre fictif) + bot simulé, aucun appel à Discord.
# live : vraie connexion OAuth2 + vrai bot.
DISCORD_MODE=mock
# Application Discord (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# Identifiant du serveur (guild) de la communauté
DISCORD_GUILD_ID=
# (*) Rôles donnant le statut Membre / Admin (liste séparée par des virgules)
DISCORD_MEMBER_ROLE_IDS=
DISCORD_ADMIN_ROLE_IDS=
# (*) Salon où le bot publie les annonces de médailles et de promotions (le seul où il écrit)
DISCORD_ANNOUNCE_CHANNEL_ID=
# (*) Lien d'invitation du bouton « Rejoindre la 501e »
DISCORD_INVITE_URL=https://discord.gg/t6UAkMCMzK
# Intervalle de resynchronisation périodique des rôles (minutes)
ROLE_SYNC_INTERVAL_MINUTES=15

# --- Stockage des images -------------------------------------------------------
# Dossier local (volume Docker en production). Accès contrôlé par l'API.
STORAGE_DIR=./storage

# --- Carte et géocodage -------------------------------------------------------
# demo   : petite liste de villes intégrée (aucun service externe, idéal en dev)
# photon : instance Photon auto-hébergée (service `photon` du docker-compose)
GEOCODER=demo
PHOTON_URL=http://localhost:2322
# Région téléchargée par le conteneur Photon (voir README). Vide = planète entière (très volumineux).
PHOTON_REGION=europe
# Fond de carte (tuiles raster). Par défaut : OpenStreetMap standard, assombri par un filtre CSS.
# Pour un trafic important, utiliser un fournisseur UE avec clé (ex. MapTiler, Stadia) ou un serveur de tuiles auto-hébergé.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION="&copy; OpenStreetMap contributors"
# dark : assombrit les tuiles claires ; none : tuiles telles quelles (si le fournisseur propose déjà un style sombre)
MAP_TILE_FILTER=dark

# --- Rétention RGPD -----------------------------------------------------------
AUDIT_LOG_RETENTION_MONTHS=12
REJECTED_IMAGE_RETENTION_DAYS=30
DEPARTED_MEMBER_RETENTION_DAYS=30
INACTIVE_ACCOUNT_MONTHS=24

# --- Divers ---------------------------------------------------------------------
LOG_LEVEL=info
