{
  "name": "501e-site",
  "version": "0.1.0",
  "private": true,
  "description": "Site officiel de la communauté RP 501e (Squad 44)",
  "workspaces": [
    "apps/api",
    "apps/web",
    "apps/bot"
  ],
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:migrate": "npm run migrate -w apps/api",
    "db:seed": "npm run seed -w apps/api",
    "db:reset": "npm run reset -w apps/api",
    "db:cities": "npm run cities:import -w apps/api",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run start -w apps/web",
    "dev:bot": "npm run dev -w apps/bot",
    "build": "npm run build -w apps/api && npm run build -w apps/bot && npm run build -w apps/web",
    "test": "npm run test -w apps/api",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "globals": "^16.4.0"
  },
  "engines": {
    "node": "^22.22.3 || >=24.15.0"
  }
}
