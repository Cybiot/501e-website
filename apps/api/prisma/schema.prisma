// Schéma de données du site 501st PIR (périmètre V1).
// Les modules V2 (batailles, formations) viendront s'ajouter ici via de nouvelles migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Statut calculé à partir des rôles Discord : none = visiteur (connecté non-membre inclus).
enum UserStatus {
  none
  member
  admin
}

enum ImageStatus {
  pending
  approved
  rejected
}

model User {
  id                   String     @id @default(cuid())
  discordId            String     @unique
  displayName          String
  discordAvatarUrl     String?
  status               UserStatus @default(none)
  /// Copie des rôles Discord lors de la dernière synchronisation (lecture seule).
  discordRoleIds       String[]   @default([])
  rankId               String?
  /// Dernier grade non nul connu : détecte une promotion même quand l'ancien rôle de grade est
  /// retiré avant que le nouveau soit ajouté (le membre passe un instant sans grade).
  lastKnownRankId      String?
  /// Date d'arrivée sur le serveur Discord de la communauté.
  joinedAt             DateTime?
  lastLoginAt          DateTime?
  lastSeenAt           DateTime?
  rolesSyncedAt        DateTime?
  /// Date à laquelle le membre a perdu son rôle (profil masqué, purge différée).
  leftAt               DateTime?
  inactivityNotifiedAt DateTime?
  // Consentements RGPD (voir ConsentRecord pour l'historique)
  consentAcceptedAt    DateTime?
  consentVersion       String?
  publicProfileEnabled Boolean    @default(true)
  consentCustomImage   Boolean    @default(false)
  consentLocation      Boolean    @default(false)
  deletedAt            DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  rank              Rank?                @relation(fields: [rankId], references: [id], onDelete: SetNull)
  profile           Profile?
  responsibilities  UserResponsibility[]
  images            CustomImage[]        @relation("ImageOwner")
  reviewedImages    CustomImage[]        @relation("ImageReviewer")
  awards            MedalAward[]         @relation("AwardRecipient")
  awardsGiven       MedalAward[]         @relation("AwardGiver")
  awardsRevoked     MedalAward[]         @relation("AwardRevoker")
  announcements     Announcement[]
  promotions        RankPromotion[]
  locations         MemberLocation[]
  sessions          Session[]
  consents          ConsentRecord[]
  auditLogs         AuditLog[]
  notificationsRead Notification[]

  @@index([status])
  @@index([rankId])
}

model Session {
  /// Empreinte SHA-256 du jeton de session (le jeton en clair n'est jamais stocké).
  id         String   @id
  userId     String
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Branche de progression. Le total de points est remis à 0 à chaque changement de branche.
enum RankBranch {
  toccoa
  enlisted
  platoon_leader
  xo
  co
  staff
}

model Rank {
  id            String     @id @default(cuid())
  name          String     @unique
  abbreviation  String
  branch        RankBranch @default(enlisted)
  /// Plus la valeur est grande, plus le grade est élevé.
  order         Int        @unique
  discordRoleId String?    @unique
  iconUrl       String?

  users          User[]
  promotionsFrom RankPromotion[] @relation("PromotionFrom")
  promotionsTo   RankPromotion[] @relation("PromotionTo")
}

/// Hiérarchie (EM, CO, XO, PL) ou pôle transverse (Staff Toccoa, Recruteur…).
enum ResponsibilityKind {
  hierarchy
  pole
}

model Responsibility {
  id            String             @id @default(cuid())
  name          String             @unique
  description   String
  kind          ResponsibilityKind @default(pole)
  discordRoleId String?            @unique
  order         Int                @default(0)

  users UserResponsibility[]
}

/// Compagnie (et camp Toccoa). Textes et logo : apps/web/src/content/compagnies.json, par slug.
/// L'appartenance se lit dans User.discordRoleIds : rôle de la compagnie ou de l'un de ses platoons.
model Company {
  id            String  @id @default(cuid())
  slug          String  @unique
  name          String  @unique
  order         Int     @default(0)
  discordRoleId String? @unique
  /// État-major : rôle de la compagnie (chefs de pôle) + grades de la branche « staff » (Lt.Col, Col).
  /// Affiché pour un membre seulement s'il n'appartient à aucune autre compagnie.
  headquarters  Boolean @default(false)

  platoons Platoon[]
}

model Platoon {
  id            String  @id @default(cuid())
  companyId     String
  name          String
  order         Int     @default(0)
  discordRoleId String? @unique

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId])
}

model UserResponsibility {
  userId           String
  responsibilityId String

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  responsibility Responsibility @relation(fields: [responsibilityId], references: [id], onDelete: Cascade)

  @@id([userId, responsibilityId])
  @@index([responsibilityId])
}

model Profile {
  userId         String  @id
  /// Phrase validée, seule affichée publiquement.
  tagline        String? @db.VarChar(140)
  customImageId  String? @unique
  pendingImageId String? @unique

  /// Phrase proposée par le membre, en attente de validation par un admin.
  pendingTagline         String?   @db.VarChar(140)
  pendingTaglineAt       DateTime?
  taglineRejectionReason String?   @db.VarChar(300)
  taglineReviewedAt      DateTime?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  customImage  CustomImage? @relation("ApprovedImage", fields: [customImageId], references: [id], onDelete: SetNull)
  pendingImage CustomImage? @relation("PendingImage", fields: [pendingImageId], references: [id], onDelete: SetNull)

  @@index([pendingTaglineAt])
}

model CustomImage {
  id              String      @id @default(cuid())
  userId          String
  storageKey      String      @unique
  status          ImageStatus @default(pending)
  rejectionReason String?
  submittedAt     DateTime    @default(now())
  reviewedAt      DateTime?
  reviewedById    String?

  user        User     @relation("ImageOwner", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy  User?    @relation("ImageReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  approvedFor Profile? @relation("ApprovedImage")
  pendingFor  Profile? @relation("PendingImage")

  @@index([status, submittedAt])
  @@index([userId])
}

/// Paliers d'une médaille (étoile bronze, argent ou or sur le ruban). Sans palier : image de base.
enum MedalTier {
  bronze
  silver
  gold
}

model Medal {
  id             String   @id @default(cuid())
  name           String   @unique
  description    String
  imageUrl       String
  /// Images des paliers : renseignées (toutes les trois) pour une médaille à paliers.
  imageBronzeUrl String?
  imageSilverUrl String?
  imageGoldUrl   String?
  category       String
  order          Int      @default(0)
  isActive       Boolean  @default(true)
  /// Un membre peut-il recevoir plusieurs fois cette médaille ?
  repeatable     Boolean  @default(true)
  /// Rôle Discord créé par le bot (sans permission) à la création de la médaille.
  discordRoleId  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  awards MedalAward[]

  @@index([isActive, order])
}

model MedalAward {
  id             String     @id @default(cuid())
  userId         String
  medalId        String
  reason         String     @db.VarChar(200)
  /// Palier choisi à l'attribution (null : image de base).
  tier           MedalTier?
  awardedById    String?
  awardedAt      DateTime   @default(now())
  announcedAt    DateTime?
  announcementId String?
  revokedAt      DateTime?
  revokedById    String?
  /// Clé fournie par le formulaire pour rendre l'attribution idempotente (double-clic).
  idempotencyKey String?    @unique

  user         User          @relation("AwardRecipient", fields: [userId], references: [id], onDelete: Cascade)
  medal        Medal         @relation(fields: [medalId], references: [id], onDelete: Restrict)
  awardedBy    User?         @relation("AwardGiver", fields: [awardedById], references: [id], onDelete: SetNull)
  revokedBy    User?         @relation("AwardRevoker", fields: [revokedById], references: [id], onDelete: SetNull)
  announcement Announcement? @relation(fields: [announcementId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([medalId])
  @@index([announcedAt, revokedAt])
}

model Announcement {
  id                String   @id @default(cuid())
  createdById       String?
  createdAt         DateTime @default(now())
  /// Un message Discord par bloc (découpage automatique selon les limites Discord).
  discordMessageIds String[]
  channelId         String
  awardsCount       Int

  promotionsCount Int @default(0)

  createdBy  User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  awards     MedalAward[]
  promotions RankPromotion[]
}

/// Montée en grade détectée par la synchronisation des rôles Discord, en attente d'annonce.
/// Au plus une promotion non annoncée par membre : une nouvelle montée la met à jour.
model RankPromotion {
  id             String    @id @default(cuid())
  userId         String
  fromRankId     String?
  toRankId       String
  promotedAt     DateTime  @default(now())
  announcedAt    DateTime?
  announcementId String?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromRank     Rank?         @relation("PromotionFrom", fields: [fromRankId], references: [id], onDelete: SetNull)
  toRank       Rank          @relation("PromotionTo", fields: [toRankId], references: [id], onDelete: Cascade)
  announcement Announcement? @relation(fields: [announcementId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([announcedAt])
}

model MemberLocation {
  id        String   @id @default(cuid())
  userId    String
  cityLabel String
  country   String
  /// Coordonnées arrondies et légèrement décalées : précision « ville » uniquement.
  lat       Float
  lng       Float
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String    @id @default(cuid())
  type      String
  payload   Json
  createdAt DateTime  @default(now())
  readAt    DateTime?
  readById  String?

  readBy User? @relation(fields: [readById], references: [id], onDelete: SetNull)

  @@index([readAt, createdAt])
  @@index([type])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  /// Empreinte de l'acteur conservée après suppression de son compte (anonymisation).
  actorHash  String?
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  /// Empreinte salée de l'IP : jamais d'adresse en clair.
  ipHash     String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId])
  @@index([action])
}

model ConsentRecord {
  id            String   @id @default(cuid())
  userId        String
  version       String
  publicProfile Boolean
  customImage   Boolean
  location      Boolean
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
